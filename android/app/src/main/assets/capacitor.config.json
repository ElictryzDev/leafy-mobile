{
	"appId": "com.leafyapp.app",
	"appName": "Leafy",
	"webDir": "../frontend/dist",
	"bundledWebRuntime": false,
	"backgroundColor": "#E8F9E9",
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 2000,
			"launchAutoHide": true,
			"backgroundColor": "#E8F9E9",
			"androidSplashResourceName": "splash",
			"androidScaleType": "CENTER_CROP",
			"showSpinner": false
		},
		"PushNotifications": {
			"presentationOptions": [
				"badge",
				"sound",
				"alert"
			]
		}
	},
	"server": {
		"androidScheme": "https",
		"allowNavigation": [
			"192.168.1.104",
			"*.leafyapp.com"
		],
		"cleartext": true
	}
}
