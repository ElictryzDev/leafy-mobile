{
  "appId": "com.leafyapp.app",
  "appName": "Leafy",
  "webDir": "../frontend/dist",
  "bundledWebRuntime": false,
  "backgroundColor": "#0F172A",
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "launchAutoHide": true,
      "backgroundColor": "#0F172A",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  },
  "server": {
    "androidScheme": "https",
    "allowNavigation": ["192.168.1.104", "*.leafyapp.com"],
    "cleartext": true
  }
}
