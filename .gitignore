# ==========================================
# Leafy Mobile - Git Ignore Rules
# Node, Capacitor, Android & Gradle
# ==========================================

# Dependencies
node_modules/
package-lock.json.log

# Android & Gradle Build Artifacts
.gradle/
build/
*/build/
app/build/
android/app/build/
android/.gradle/
android/build/

# Android Studio & IDE
.idea/
android/.idea/
*.iml
android/*.iml
android/app/*.iml
local.properties
.navigation
captures/
.externalNativeBuild/
.cxx/

# OS Specific
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# Logs & Debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Release artifacts (Keep versioned release build)
*.apk
*.aab
!release/*.apk

# Temporary files
*.tmp
*.bak
*.swp
